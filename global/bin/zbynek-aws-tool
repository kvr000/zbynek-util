#!/usr/bin/env python3

# Utility to do various dev tasks:
#
# zbynek-aws-tool - various AWS manipulation utilities:
#   dynamodb convert: converts DynamoDb type based output to simple JSON
#   get-log: retrieves a full CloudWatch log stream, formatted as "<UTC timestamp> <message>" lines
#             (--tail to keep polling for new events, like tail -f)
