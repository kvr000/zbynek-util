from __future__ import annotations

import logging
import json
import sys
import argparse
import subprocess
import os
import time
import copy
import re
import uuid
from datetime import datetime, timezone
from typing import TextIO


class Command:
    def run(self, args) -> int:
        exit: int | None = self.setup(args)
        if exit is not None:
            return exit
        return self.execute()

    def setup(self, args) -> int | None:
        return None

    def execute(self) -> int:
        return 0


class MainSubCommand(Command):
    main: Main

    def __init__(self, parent):
        self.main = parent


class DynamoDbConvertCommand(MainSubCommand):
    inputs: list[str] = list()

    def __init__(self, parent):
        super().__init__(parent)
        self.main = parent

    def setup(self, args) -> int | None:
        parser = argparse.ArgumentParser(prog=args[0], description="Convert DynamoDb type based output to simple JSON")

        parser.parse_args(args[1:], namespace=self)

        return None

    def execute(self) -> int:
        dynamodb_json = json.load(sys.stdin)

        if "Items" in dynamodb_json:
            # Handle the full DynamoDB dump
            simplified_items = [self.convert_map(item) for item in dynamodb_json["Items"]]
            simplified_json = {"Items": simplified_items}
        else:
            simplified_json = self.convert_map(dynamodb_json)

        json.dump(simplified_json, sys.stdout, indent=4)
        print()
        return 0

    def convert_map(self, value: dict[str, object]) -> dict[str, object]:
        return {k: self.convert_value(v) for k, v in value.items()}

    def convert_value(self, value):
        if isinstance(value, dict):
            key = next(iter(value))
            if key == "S" or key == "N":
                return int(value[key]) if key == "N" else value[key]
            elif key == "M":
                return {k: self.convert_value(v) for k, v in value[key].items()}
            elif key == "L":
                return [self.convert_value(v) for v in value[key]]
            elif key == "BOOL":
                return value[key]
            elif key == "NULL":
                return None
            else:
                raise ValueError(f"Unsupported type: {key}")
        return value  # Return the value as-is if it's not a dict.


class DynamoDbCommand(MainSubCommand):
    command: Command | None = None
    subcommand: list[str] = []

    def setup(self, args) -> int | None:
        parser = argparse.ArgumentParser(prog=args[0], description="Zbynek Dev Tool")
        parser.add_argument("subcommand", type=str, nargs=argparse.REMAINDER)

        parser.parse_args(args[1:], namespace=self)

        if len(self.subcommand) < 1:
            print(f"usage: {args[0]} subcommand ...", file=sys.stderr)
            return 122

        if self.subcommand[0] == 'convert':
            self.command = DynamoDbConvertCommand(self)
        else:
            print("Supported subcommands: convert", file=sys.stderr)
            return 122

        self.subcommand[0] = args[0] + " " + self.subcommand[0]
        return self.command.run(self.subcommand)


class GetLogCommand(MainSubCommand):
    POLL_INTERVAL_SECONDS = 2
    # Maximum events returned by a single GetLogEvents call
    MAX_PAGE_EVENTS = 10000

    group: str
    stream: str
    tail: bool = False
    last: int | None = None

    def setup(self, args) -> int | None:
        parser = argparse.ArgumentParser(prog=args[0], description="Retrieve a full CloudWatch log stream, formatted as 'timestamp message' lines")
        parser.add_argument("group", type=str, help="CloudWatch log group name")
        parser.add_argument("stream", type=str, help="CloudWatch log stream name")
        parser.add_argument("-f", "--tail", action="store_true",
                             help="After reaching the end of the stream, keep polling for new events instead of exiting (like tail -f)")
        parser.add_argument("-n", "--last", type=int, metavar="NUMBER",
                             help="Print only the last NUMBER events instead of the full stream (like tail -n), can be combined with -f")

        parser.parse_args(args[1:], namespace=self)

        if self.last is not None and self.last < 0:
            parser.error("--last must not be negative")

        return None

    def get_log_events(self, extra: list[str]) -> dict:
        cmd = [
            "aws", "logs", "get-log-events",
            "--log-group-name", self.group,
            "--log-stream-name", self.stream,
            "--output", "json",
        ] + extra

        # Force the aws CLI subprocess itself to emit UTF-8 on stdout/stderr, regardless of
        # the local/system locale. The aws CLI is a Python program: absent this, Python
        # picks its stdout text encoding from the locale.
        child_env = {**os.environ, "PYTHONUTF8": "1" ,
            # "AWS_CLI_OUTPUT_ENCODING": "UTF-8", "AWS_CLI_FILE_ENCODING": "UTF-8",
        }
        result = subprocess.run(cmd, capture_output=True, env=child_env)
        if result.returncode != 0:
            sys.stderr.buffer.write(result.stderr)
            raise GetLogCommand.AwsFailed(result.returncode)

        # Decode with surrogateescape rather than strict utf-8: CloudWatch log messages can
        # contain bytes that are not valid UTF-8 (binary data, a different original encoding,
        # etc). surrogateescape preserves those bytes losslessly in the string instead of
        # raising UnicodeDecodeError; print_event() encodes back the same way on output so the
        # original bytes reach stdout unchanged instead of crashing or being lost.
        return json.loads(result.stdout.decode("utf-8", errors="surrogateescape"))

    def read_last(self) -> str | None:
        """
        Prints the last self.last events and returns the forward token to continue from.

        Without --start-from-head, GetLogEvents returns the newest events, so only the
        requested tail is downloaded. Requests above one page are completed by paging
        backward via nextBackwardToken.
        """
        remaining = self.last
        data = self.get_log_events(["--limit", str(max(1, min(remaining, self.MAX_PAGE_EVENTS)))])
        forward_token = data.get("nextForwardToken")
        pages: list[list[dict]] = []
        if remaining > 0:
            events = data.get("events", [])[-remaining:]
            pages.append(events)
            remaining -= len(events)
            backward_token = data.get("nextBackwardToken")
            while remaining > 0 and backward_token is not None:
                data = self.get_log_events([
                    "--limit", str(min(remaining, self.MAX_PAGE_EVENTS)),
                    "--next-token", backward_token,
                ])
                events = data.get("events", [])[-remaining:]
                pages.append(events)
                remaining -= len(events)
                new_token = data.get("nextBackwardToken")
                if new_token == backward_token:
                    # reached the beginning of the stream
                    break
                backward_token = new_token

        for events in reversed(pages):
            for event in events:
                self.print_event(sys.stdout, event)
        sys.stdout.flush()
        return forward_token

    def execute(self) -> int:
        try:
            # With --last, continue forward right after the printed tail; otherwise start from head
            next_token: str | None = self.read_last() if self.last is not None else None

            while True:
                extra = ["--start-from-head"]
                if next_token is not None:
                    extra += ["--next-token", next_token]
                data = self.get_log_events(extra)
                for event in data.get("events", []):
                    self.print_event(sys.stdout, event)
                sys.stdout.flush()

                new_token = data.get("nextForwardToken")
                caught_up = new_token == next_token
                next_token = new_token

                if caught_up:
                    if not self.tail:
                        break
                    time.sleep(self.POLL_INTERVAL_SECONDS)
        except GetLogCommand.AwsFailed as ex:
            return ex.returncode
        except KeyboardInterrupt:
            return 130

        return 0

    class AwsFailed(Exception):
        def __init__(self, returncode: int):
            super().__init__(f"aws failed with exit code {returncode}")
            self.returncode = returncode

    @staticmethod
    def print_event(fd: TextIO, event: dict) -> None:
        # Use the event's 'timestamp' (time recorded by the log producer / PutLogEvents caller),
        # not 'ingestionTime' (when CloudWatch Logs received/stored it): 'timestamp' reflects when
        # the event actually happened, which is what a log file's timestamp column should show.
        epoch_ms = event["timestamp"]
        dt = datetime.fromtimestamp(epoch_ms / 1000, tz=timezone.utc)
        ts_str = dt.strftime("%Y-%m-%dT%H:%M:%S") + f".{epoch_ms % 1000:03d}Z"
        message = event["message"].rstrip("\n")
        line = f"{ts_str} {message}\n"
        fd.buffer.write(line.encode("utf-8", errors="surrogateescape"))


class CloudFormationRemovePartCommand(MainSubCommand):
    """
    Removes resources from a CloudFormation stack WITHOUT deleting the underlying physical resources.

    CloudFormation has no direct "forget this resource" operation, so this follows the documented
    two-step procedure:
      1. update the stack with DeletionPolicy: Retain on the resources to remove,
      2. update the stack again with the resources deleted from the template
         (the retained physical resources are left alone and become unmanaged).
    """

    # TemplateBody size limit of CloudFormation when the template is not uploaded to S3
    MAX_TEMPLATE_BYTES = 51200
    STABLE_STATUSES = {
        "CREATE_COMPLETE", "UPDATE_COMPLETE", "UPDATE_ROLLBACK_COMPLETE",
        "IMPORT_COMPLETE", "IMPORT_ROLLBACK_COMPLETE",
    }

    stack: str
    resources: list[str]
    profile: str | None = None
    region: str | None = None
    dry_run: bool = False
    yes: bool = False
    delete: bool = False
    s3_bucket: str | None = None

    def setup(self, args) -> int | None:
        parser = argparse.ArgumentParser(
            prog=args[0],
            description="Remove resources from a CloudFormation stack, by default keeping the physical resources "
                        "(sets DeletionPolicy: Retain, then removes the resources from the template); "
                        "with --delete the physical resources are deleted too")
        parser.add_argument("stack", type=str, help="CloudFormation stack name or ID")
        parser.add_argument("resources", type=str, nargs="+", metavar="logical-id",
                             help="Logical ID of the resource to remove from the stack")
        parser.add_argument("--profile", type=str, help="AWS CLI profile")
        parser.add_argument("--region", type=str, help="AWS region")
        parser.add_argument("-d", "--delete", action="store_true",
                             help="Delete the physical resources too (a Retain DeletionPolicy is overridden; "
                                  "Snapshot is still honoured)")
        parser.add_argument("--s3-bucket", type=str, metavar="BUCKET",
                             help="S3 bucket to temporarily upload the template to when it exceeds the "
                                  "51200 bytes limit of direct upload (the uploaded object is deleted afterwards)")
        parser.add_argument("-n", "--dry-run", action="store_true",
                             help="Only show what would be done")
        parser.add_argument("-y", "--yes", action="store_true",
                             help="Do not ask for confirmation")

        parser.parse_args(args[1:], namespace=self)
        return None

    class AwsFailed(Exception):
        def __init__(self, returncode: int, stderr: str):
            super().__init__(f"aws failed with exit code {returncode}: {stderr.strip()}")
            self.returncode = returncode
            self.stderr = stderr

    def aws(self, args: list[str]) -> str:
        cmd = ["aws"]
        if self.profile:
            cmd += ["--profile", self.profile]
        if self.region:
            cmd += ["--region", self.region]
        cmd += args
        result = subprocess.run(cmd, capture_output=True, env={**os.environ, "PYTHONUTF8": "1"})
        stdout = result.stdout.decode("utf-8", errors="replace")
        if result.returncode != 0:
            raise CloudFormationRemovePartCommand.AwsFailed(result.returncode, result.stderr.decode("utf-8", errors="replace"))
        return stdout

    @staticmethod
    def load_yaml(text: str):
        import yaml

        class CfnTag:
            def __init__(self, tag, value):
                self.tag = tag
                self.value = value

        class Loader(yaml.SafeLoader):
            pass

        def construct_tag(loader, suffix, node):
            if isinstance(node, yaml.ScalarNode):
                value = loader.construct_scalar(node)
            elif isinstance(node, yaml.SequenceNode):
                value = loader.construct_sequence(node, deep=True)
            else:
                value = loader.construct_mapping(node, deep=True)
            return CfnTag("!" + suffix, value)

        Loader.add_multi_constructor("!", construct_tag)

        def represent_tag(dumper, data):
            if isinstance(data.value, dict):
                return dumper.represent_mapping(data.tag, data.value)
            elif isinstance(data.value, list):
                return dumper.represent_sequence(data.tag, data.value)
            return dumper.represent_scalar(data.tag, data.value)

        class Dumper(yaml.SafeDumper):
            pass

        Dumper.add_representer(CfnTag, represent_tag)

        return yaml.load(text, Loader=Loader), lambda t: yaml.dump(t, Dumper=Dumper, default_flow_style=False, sort_keys=False)

    def load_template(self, stack_id: str):
        """Returns (template dict, serializer function)."""
        body = json.loads(self.aws([
            "cloudformation", "get-template", "--stack-name", stack_id,
            "--template-stage", "Original", "--output", "json"]))["TemplateBody"]
        if isinstance(body, dict):
            return body, lambda t: json.dumps(t, indent=2)
        try:
            return json.loads(body), lambda t: json.dumps(t, indent=2)
        except ValueError:
            pass
        try:
            return self.load_yaml(body)
        except ImportError:
            raise SystemExit("YAML template requires PyYAML: pip install pyyaml")

    def update_stack(self, stack: dict, template_text: str) -> bool:
        """Returns False if CloudFormation found nothing to update."""
        if len(template_text.encode("utf-8")) > self.MAX_TEMPLATE_BYTES:
            try:
                # JSON can be shrunk by dropping the indentation
                template_text = json.dumps(json.loads(template_text), separators=(",", ":"))
            except ValueError:
                pass
        use_s3 = len(template_text.encode("utf-8")) > self.MAX_TEMPLATE_BYTES
        if use_s3 and not self.s3_bucket:
            raise SystemExit(f"Template exceeds {self.MAX_TEMPLATE_BYTES} bytes, specify --s3-bucket BUCKET to upload it via S3")
        stack_id = stack["StackId"]
        s3_uri = None
        # Use a file in the current directory with a relative path, not the system temp directory:
        # under Cygwin, /tmp/... is not resolvable by the native Windows aws CLI.
        path = f".zbynek-aws-tool-{uuid.uuid4()}.template"
        try:
            with open(path, "w", encoding="utf-8", newline="\n") as f:
                f.write(template_text)
            if use_s3:
                key = f"zbynek-aws-tool/cf-remove/{uuid.uuid4()}.template"
                s3_uri = f"s3://{self.s3_bucket}/{key}"
                self.aws(["s3", "cp", path, s3_uri, "--only-show-errors"])
                # arn:aws:cloudformation:<region>:<account>:stack/<name>/<id>
                region = self.region or stack_id.split(":")[3]
                template_arg = ["--template-url", f"https://{self.s3_bucket}.s3.{region}.amazonaws.com/{key}"]
            else:
                template_arg = ["--template-body", "file://" + path]
            cmd = ["cloudformation", "update-stack", "--stack-name", stack_id] + template_arg
            parameters = [p["ParameterKey"] for p in stack.get("Parameters", [])]
            if parameters:
                cmd += ["--parameters"] + [f"ParameterKey={k},UsePreviousValue=true" for k in parameters]
            if stack.get("Capabilities"):
                cmd += ["--capabilities"] + stack["Capabilities"]
            try:
                self.aws(cmd)
            except CloudFormationRemovePartCommand.AwsFailed as ex:
                if "No updates are to be performed" in ex.stderr:
                    return False
                raise
            finally:
                if s3_uri is not None:
                    try:
                        self.aws(["s3", "rm", s3_uri, "--only-show-errors"])
                    except CloudFormationRemovePartCommand.AwsFailed as ex:
                        print(f"Failed to delete {s3_uri}: {ex.stderr.strip()}", file=sys.stderr)
        finally:
            try:
                os.remove(path)
            except OSError:
                pass
        print("  waiting for stack update to complete...", file=sys.stderr)
        self.aws(["cloudformation", "wait", "stack-update-complete", "--stack-name", stack_id])
        return True

    SUB_REF = re.compile(r"\$\{([A-Za-z0-9]+)(?:\.[^}]*)?\}")

    @staticmethod
    def find_references(node, names: set[str]) -> set[str]:
        """Finds references (Ref, GetAtt, Sub, in both long and YAML short forms) to the given logical names."""
        found: set[str] = set()

        def sub_string(text):
            if isinstance(text, str):
                found.update(n for n in CloudFormationRemovePartCommand.SUB_REF.findall(text) if n in names)

        def walk(n):
            if isinstance(n, dict):
                for k, v in n.items():
                    if k == "Ref" and isinstance(v, str):
                        if v in names:
                            found.add(v)
                    elif k == "Fn::GetAtt":
                        target = v[0] if isinstance(v, list) and v else v
                        if isinstance(target, str) and target.split(".")[0] in names:
                            found.add(target.split(".")[0])
                    elif k == "Fn::Sub":
                        sub_string(v[0] if isinstance(v, list) and v else v)
                    walk(v)
            elif isinstance(n, list):
                for v in n:
                    walk(v)
            elif hasattr(n, "tag") and hasattr(n, "value"):
                v = n.value
                if n.tag == "!Ref" and isinstance(v, str):
                    if v in names:
                        found.add(v)
                elif n.tag == "!GetAtt":
                    target = v[0] if isinstance(v, list) and v else v
                    if isinstance(target, str) and target.split(".")[0] in names:
                        found.add(target.split(".")[0])
                elif n.tag == "!Sub":
                    sub_string(v[0] if isinstance(v, list) and v else v)
                walk(v)

        walk(node)
        return found

    @staticmethod
    def strip_dependencies(template: dict, removed: set[str]) -> None:
        for resource in template["Resources"].values():
            depends = resource.get("DependsOn")
            if depends is None:
                continue
            if isinstance(depends, str):
                if depends in removed:
                    del resource["DependsOn"]
            else:
                remaining = [d for d in depends if d not in removed]
                if remaining:
                    resource["DependsOn"] = remaining
                else:
                    del resource["DependsOn"]

    def execute(self) -> int:
        try:
            return self.do_execute()
        except CloudFormationRemovePartCommand.AwsFailed as ex:
            sys.stderr.write(ex.stderr)
            return ex.returncode
        except KeyboardInterrupt:
            return 130

    def do_execute(self) -> int:
        stack = json.loads(self.aws([
            "cloudformation", "describe-stacks", "--stack-name", self.stack, "--output", "json"]))["Stacks"][0]
        stack_id = stack["StackId"]
        if stack["StackStatus"] not in self.STABLE_STATUSES:
            print(f"Stack {self.stack} is in status {stack['StackStatus']}, which does not allow update", file=sys.stderr)
            return 1

        template, serialize = self.load_template(stack_id)
        template_resources = template.get("Resources", {})
        removed = list(dict.fromkeys(self.resources))
        missing = [r for r in removed if r not in template_resources]
        if missing:
            print(f"Resources not found in stack template: {', '.join(missing)}", file=sys.stderr)
            print(f"Available: {', '.join(template_resources)}", file=sys.stderr)
            return 1

        # CloudFormation rejects the update if anything remaining still refers to a removed resource
        removed_set = set(removed)
        dangling = []
        for section, content in template.items():
            if not isinstance(content, dict):
                continue
            for name, value in content.items():
                if section == "Resources" and name in removed_set:
                    continue
                refs = self.find_references(value, removed_set)
                if refs:
                    dangling.append(f"  {section}.{name} references {', '.join(sorted(refs))}")
        if dangling:
            print("Cannot remove, the following still reference the removed resources:", file=sys.stderr)
            print("\n".join(dangling), file=sys.stderr)
            print("Remove the referencing resources too (add them to the command), or edit the stack template first",
                  file=sys.stderr)
            return 1

        physical = {r["LogicalResourceId"]: r for r in json.loads(self.aws([
            "cloudformation", "describe-stack-resources", "--stack-name", stack_id,
            "--output", "json"]))["StackResources"]}

        print(f"Stack {stack['StackName']} ({stack['StackStatus']}): removing, physical resources are "
              + ("DELETED:" if self.delete else "kept:"))
        for logical in removed:
            info = physical.get(logical, {})
            print(f"  {logical}  {info.get('ResourceType', '?')}  {info.get('PhysicalResourceId', '?')}"
                  f"  (DeletionPolicy: {template_resources[logical].get('DeletionPolicy', 'Delete')})")
        if self.dry_run:
            return 0
        if not self.yes:
            if input("Proceed" + (" and DELETE the physical resources" if self.delete else "") + "? [y/N] ").strip().lower() not in ("y", "yes"):
                print("Aborted", file=sys.stderr)
                return 1

        if self.delete:
            # Step 1: make sure the physical resources do get deleted along with the removal
            to_unretain = [r for r in removed if template_resources[r].get("DeletionPolicy") == "Retain"]
            if to_unretain:
                print(f"Step 1/2: clearing DeletionPolicy: Retain on {', '.join(to_unretain)}", file=sys.stderr)
                unretained = copy.deepcopy(template)
                for logical in to_unretain:
                    del unretained["Resources"][logical]["DeletionPolicy"]
                self.update_stack(stack, serialize(unretained))
            else:
                print("Step 1/2: nothing to change, no resource has DeletionPolicy: Retain", file=sys.stderr)
            to_retain = []
        else:
            # Step 1: make sure the physical resources survive the removal
            to_retain = [r for r in removed if template_resources[r].get("DeletionPolicy") != "Retain"]
        if to_retain:
            print(f"Step 1/2: setting DeletionPolicy: Retain on {', '.join(to_retain)}", file=sys.stderr)
            retained = copy.deepcopy(template)
            for logical in to_retain:
                retained["Resources"][logical]["DeletionPolicy"] = "Retain"
            self.update_stack(stack, serialize(retained))
        elif not self.delete:
            print("Step 1/2: all resources already have DeletionPolicy: Retain", file=sys.stderr)

        # Step 2: remove the resources from the stack
        print(f"Step 2/2: removing {', '.join(removed)} from the template", file=sys.stderr)
        reduced = copy.deepcopy(template)
        for logical in removed:
            del reduced["Resources"][logical]
        self.strip_dependencies(reduced, set(removed))
        self.update_stack(stack, serialize(reduced))

        print("Done, the following physical resources were deleted:" if self.delete
              else "Done, the following physical resources are now unmanaged:")
        for logical in removed:
            info = physical.get(logical, {})
            print(f"  {info.get('ResourceType', '?')}  {info.get('PhysicalResourceId', '?')}")
        return 0


class CloudFormationCommand(MainSubCommand):
    command: Command | None = None
    subcommand: list[str] = []

    def setup(self, args) -> int | None:
        parser = argparse.ArgumentParser(prog=args[0], description="CloudFormation utilities")
        parser.add_argument("subcommand", type=str, nargs=argparse.REMAINDER)

        parser.parse_args(args[1:], namespace=self)

        if len(self.subcommand) < 1:
            print(f"usage: {args[0]} subcommand ...", file=sys.stderr)
            return 122

        if self.subcommand[0] == 'remove-part':
            self.command = CloudFormationRemovePartCommand(self)
        else:
            print("Supported subcommands: remove-part", file=sys.stderr)
            return 122

        self.subcommand[0] = args[0] + " " + self.subcommand[0]
        return self.command.run(self.subcommand)


class Main(Command):
    command: Command | None = None
    subcommand: list[str] = []

    def setup(self, args) -> int | None:
        parser = argparse.ArgumentParser(prog=args[0], description="Zbynek Dev Tool")
        parser.add_argument("subcommand", type=str, nargs=argparse.REMAINDER)

        parser.parse_args(args[1:], namespace=self)

        if len(self.subcommand) < 1:
            print(f"usage: {args[0]} subcommand ...", file=sys.stderr)
            return 122

        if self.subcommand[0] == 'dynamodb':
            self.command = DynamoDbCommand(self)
        elif self.subcommand[0] == 'get-log':
            self.command = GetLogCommand(self)
        elif self.subcommand[0] == 'cloud-formation' or self.subcommand[0] == 'cloudformation':
            self.command = CloudFormationCommand(self)
        else:
            print("Supported subcommands: dynamodb get-log cloud-formation", file=sys.stderr)
            return 122

        self.subcommand[0] = args[0] + " " + self.subcommand[0]
        return self.command.run(self.subcommand)


if __name__ == "__main__":
    logging.basicConfig(
        format='%(asctime)s %(levelname)-8s %(message)s',
        level=logging.INFO,
        datefmt='%Y-%m-%d %H:%M:%S'
    )

    sys.exit(Main().run(sys.argv))
