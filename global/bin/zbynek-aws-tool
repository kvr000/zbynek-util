from __future__ import annotations

import logging
import json
import sys
import argparse
import subprocess
import os
import time
from datetime import datetime, timezone
from typing import TextIO


class Command:
    def run(self, args) -> int:
        exit: int | None = self.setup(args)
        if exit is not None:
            return exit
        return self.execute()

    def setup(self, args) -> int | None:
        return None

    def execute(self) -> int:
        return 0


class MainSubCommand(Command):
    main: Main

    def __init__(self, parent):
        self.main = parent


class DynamoDbConvertCommand(MainSubCommand):
    inputs: list[str] = list()

    def __init__(self, parent):
        super().__init__(parent)
        self.main = parent

    def setup(self, args) -> int | None:
        parser = argparse.ArgumentParser(prog=args[0], description="Convert DynamoDb type based output to simple JSON")

        parser.parse_args(args[1:], namespace=self)

        return None

    def execute(self) -> int:
        dynamodb_json = json.load(sys.stdin)

        if "Items" in dynamodb_json:
            # Handle the full DynamoDB dump
            simplified_items = [self.convert_map(item) for item in dynamodb_json["Items"]]
            simplified_json = {"Items": simplified_items}
        else:
            simplified_json = self.convert_map(dynamodb_json)

        json.dump(simplified_json, sys.stdout, indent=4)
        print()
        return 0

    def convert_map(self, value: dict[str, object]) -> dict[str, object]:
        return {k: self.convert_value(v) for k, v in value.items()}

    def convert_value(self, value):
        if isinstance(value, dict):
            key = next(iter(value))
            if key == "S" or key == "N":
                return int(value[key]) if key == "N" else value[key]
            elif key == "M":
                return {k: self.convert_value(v) for k, v in value[key].items()}
            elif key == "L":
                return [self.convert_value(v) for v in value[key]]
            elif key == "BOOL":
                return value[key]
            elif key == "NULL":
                return None
            else:
                raise ValueError(f"Unsupported type: {key}")
        return value  # Return the value as-is if it's not a dict.


class DynamoDbCommand(MainSubCommand):
    command: Command | None = None
    subcommand: list[str] = []

    def setup(self, args) -> int | None:
        parser = argparse.ArgumentParser(prog=args[0], description="Zbynek Dev Tool")
        parser.add_argument("subcommand", type=str, nargs=argparse.REMAINDER)

        parser.parse_args(args[1:], namespace=self)

        if len(self.subcommand) < 1:
            print(f"usage: {args[0]} subcommand ...", file=sys.stderr)
            return 122

        if self.subcommand[0] == 'convert':
            self.command = DynamoDbConvertCommand(self)
        else:
            print("Supported subcommands: convert", file=sys.stderr)
            return 122

        self.subcommand[0] = args[0] + " " + self.subcommand[0]
        return self.command.run(self.subcommand)


class GetLogCommand(MainSubCommand):
    POLL_INTERVAL_SECONDS = 2

    group: str
    stream: str
    tail: bool = False

    def setup(self, args) -> int | None:
        parser = argparse.ArgumentParser(prog=args[0], description="Retrieve a full CloudWatch log stream, formatted as 'timestamp message' lines")
        parser.add_argument("group", type=str, help="CloudWatch log group name")
        parser.add_argument("stream", type=str, help="CloudWatch log stream name")
        parser.add_argument("-f", "--tail", action="store_true",
                             help="After reaching the end of the stream, keep polling for new events instead of exiting (like tail -f)")

        parser.parse_args(args[1:], namespace=self)

        return None

    def execute(self) -> int:
        next_token: str | None = None

        try:
            while True:
                cmd = [
                    "aws", "logs", "get-log-events",
                    "--log-group-name", self.group,
                    "--log-stream-name", self.stream,
                    "--start-from-head",
                    "--output", "json",
                ]
                if next_token is not None:
                    cmd += ["--next-token", next_token]

                # Force the aws CLI subprocess itself to emit UTF-8 on stdout/stderr, regardless of
                # the local/system locale. The aws CLI is a Python program: absent this, Python
                # picks its stdout text encoding from the locale.
                child_env = {**os.environ, "PYTHONUTF8": "1" ,
                    # "AWS_CLI_OUTPUT_ENCODING": "UTF-8", "AWS_CLI_FILE_ENCODING": "UTF-8",
                }
                result = subprocess.run(cmd, capture_output=True, env=child_env)
                if result.returncode != 0:
                    sys.stderr.buffer.write(result.stderr)
                    return result.returncode

                # Decode with surrogateescape rather than strict utf-8: CloudWatch log messages can
                # contain bytes that are not valid UTF-8 (binary data, a different original encoding,
                # etc). surrogateescape preserves those bytes losslessly in the string instead of
                # raising UnicodeDecodeError; print_event() encodes back the same way on output so the
                # original bytes reach stdout unchanged instead of crashing or being lost.
                data = json.loads(result.stdout.decode("utf-8", errors="surrogateescape"))
                for event in data.get("events", []):
                    self.print_event(sys.stdout, event)
                sys.stdout.flush()

                new_token = data.get("nextForwardToken")
                caught_up = new_token == next_token
                next_token = new_token

                if caught_up:
                    if not self.tail:
                        break
                    sys.stdout.flush()
                    time.sleep(self.POLL_INTERVAL_SECONDS)
        except KeyboardInterrupt:
            return 130

        return 0

    @staticmethod
    def print_event(fd: TextIO, event: dict) -> None:
        # Use the event's 'timestamp' (time recorded by the log producer / PutLogEvents caller),
        # not 'ingestionTime' (when CloudWatch Logs received/stored it): 'timestamp' reflects when
        # the event actually happened, which is what a log file's timestamp column should show.
        epoch_ms = event["timestamp"]
        dt = datetime.fromtimestamp(epoch_ms / 1000, tz=timezone.utc)
        ts_str = dt.strftime("%Y-%m-%dT%H:%M:%S") + f".{epoch_ms % 1000:03d}Z"
        message = event["message"].rstrip("\n")
        line = f"{ts_str} {message}\n"
        fd.buffer.write(line.encode("utf-8", errors="surrogateescape"))


class Main(Command):
    command: Command | None = None
    subcommand: list[str] = []

    def setup(self, args) -> int | None:
        parser = argparse.ArgumentParser(prog=args[0], description="Zbynek Dev Tool")
        parser.add_argument("subcommand", type=str, nargs=argparse.REMAINDER)

        parser.parse_args(args[1:], namespace=self)

        if len(self.subcommand) < 1:
            print(f"usage: {args[0]} subcommand ...", file=sys.stderr)
            return 122

        if self.subcommand[0] == 'dynamodb':
            self.command = DynamoDbCommand(self)
        elif self.subcommand[0] == 'get-log':
            self.command = GetLogCommand(self)
        else:
            print("Supported subcommands: dynamodb get-log", file=sys.stderr)
            return 122

        self.subcommand[0] = args[0] + " " + self.subcommand[0]
        return self.command.run(self.subcommand)


if __name__ == "__main__":
    logging.basicConfig(
        format='%(asctime)s %(levelname)-8s %(message)s',
        level=logging.INFO,
        datefmt='%Y-%m-%d %H:%M:%S'
    )

    sys.exit(Main().run(sys.argv))
