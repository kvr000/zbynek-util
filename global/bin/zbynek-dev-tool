from __future__ import annotations

import argparse
import errno
import fnmatch
import logging
import os
import queue
import re
import select
import shutil
import stat
import struct
import subprocess
import sys
import tempfile
import time


class Command:
    def run(self, args) -> int:
        exit: int | None = self.setup(args)
        if exit is not None:
            return exit
        return self.execute()

    def setup(self, args) -> int | None:
        return None

    def execute(self) -> int:
        return 0


class MainSubCommand(Command):
    main: Main

    def __init__(self, parent):
        self.main = parent


class SpotlessToDiffCommand(MainSubCommand):
    def __init__(self, parent):
        super().__init__(parent)
        self.main = parent

    def setup(self, args) -> int | None:
        parser = argparse.ArgumentParser(prog=args[0], description="Convert spotless to diff")

        parser.parse_args(args[1:], namespace=self)

        return None

    def execute(self) -> int:
        EMPTY_PATTERN = re.compile(r'^\s*$')
        CHANGE_PATTERN = re.compile(r'^(\s*)(@@ .*)$')
        FILE_PATTERN = re.compile(r'^\s+(.*\S)\s*')
        line = None
        while True:
            if line is None and (line := sys.stdin.readline()) == "":
                break
            empty_lines = False
            if not (fm := FILE_PATTERN.match(line)):
                line = None
                continue
            if (line := sys.stdin.readline()) == "":
                break
            if EMPTY_PATTERN.match(line):
                if (line := sys.stdin.readline()) == "":
                    break
                empty_lines = True
            if not (cm := CHANGE_PATTERN.match(line)):
                break
            indent = cm.group(1)
            file = fm.group(1)
            print(f"diff a/{file} b/{file}")
            print(f"--- a/{file}")
            print(f"+++ a/{file}")
            print(cm.group(2))
            while True:
                line = sys.stdin.readline()
                if empty_lines:
                    if not EMPTY_PATTERN.match(line):
                        raise ValueError("Expected empty line, got: " + line)
                    line = sys.stdin.readline()
                if line == "":
                    break
                if not line.startswith(indent):
                    if not EMPTY_PATTERN.match(line):
                        break
                    else:
                        line = " "
                else:
                    line = line[len(indent):]
                line = re.sub(r'(·+)', lambda m: ' ' * len(m.group(1)), line, flags=0)
                print(line, end = "")

        return 0


class LogToTimestamp(MainSubCommand):
    def __init__(self, parent):
        super().__init__(parent)
        self.main = parent

    def setup(self, args) -> int | None:
        parser = argparse.ArgumentParser(prog=args[0], description="Convert log CSV epoch timestamps to UTC")
        parser.parse_args(args[1:], namespace=self)
        return None

    def execute(self) -> int:
        import csv
        from datetime import datetime, timezone

        reader = csv.reader(sys.stdin)
        for i, row in enumerate(reader):
            if not row:
                continue
            if i == 0 and row[0].strip().lower() == "timestamp":
                continue
            try:
                ts_ms = int(row[0])
                row[0] = (
                        datetime.fromtimestamp(ts_ms / 1000, tz=timezone.utc)
                        .strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"
                )
            except ValueError:
                pass
            message = row[1] if len(row) > 1 else ""
            lines = message.splitlines()
            first = lines[0] if lines else ""
            rest = lines[1:]
            sys.stdout.write(f"{row[0]} {first}\n")
            for line in rest:
                sys.stdout.write(f"\t{line}\n")

        return 0


class CommandError(Exception):
    pass


class Git:
    """
    Thin wrapper around the external "git" binary. All git interaction for the tool goes through
    here (rev-parse, rev-list, diff, read-tree, update-index, write-tree, commit-tree, apply,
    reset) rather than any Python git library, since the Python interpreter may be Windows-native
    while git itself is Cygwin, and the two do not always agree on how paths/indexes/modes behave.
    """

    MODE_EXEC = "100755"
    MODE_NOEXEC = "100644"

    def run(self, args: list[str], env: dict | None = None, input: str | None = None, check: bool = True) -> subprocess.CompletedProcess:
        result = subprocess.run(["git"] + args, capture_output=True, text=True, env=env, input=input)
        if check and result.returncode != 0:
            raise CommandError(f"git {' '.join(args)} failed: {result.stderr.strip()}")
        return result

    def output(self, args: list[str], env: dict | None = None) -> str:
        return self.run(args, env=env).stdout

    def rev_parse(self, rev: str) -> str:
        return self.output(["rev-parse", rev]).strip()

    def rev_parse_parent(self, sha: str) -> str | None:
        result = self.run(["rev-parse", f"{sha}^"], check=False)
        return result.stdout.strip() if result.returncode == 0 else None

    def current_branch(self) -> str | None:
        result = self.run(["symbolic-ref", "--short", "-q", "HEAD"], check=False)
        return result.stdout.strip() if result.returncode == 0 else None

    def is_worktree_clean(self) -> bool:
        return not self.output(["status", "--porcelain"]).strip()

    def commits_between(self, base: str, head: str) -> list[str]:
        return self.output(["rev-list", "--reverse", f"{base}..{head}"]).split()

    def parent_of(self, sha: str) -> str | None:
        parents = self.output(["rev-list", "--parents", "-n1", sha]).split()[1:]
        if len(parents) > 1:
            raise CommandError(f"merge commit {sha} is not supported")
        return parents[0] if parents else None

    def find_mode_flips(self, diff_args: list[str]) -> list[tuple[str, str, str]]:
        """
        Runs "git diff --raw" with the given extra arguments (e.g. two commits, or ["--cached"],
        or no argument at all for worktree-vs-index) and returns the pure executable-bit flips
        found, as (path, correct_mode, current_mode) tuples.
        """
        output = self.output(["diff", "--raw", "--no-renames", "-z"] + diff_args)
        tokens = output.split("\0")
        flips = []
        i = 0
        while i < len(tokens) - 1:
            meta = tokens[i]
            path = tokens[i + 1]
            i += 2
            if not meta:
                continue
            fields = meta.split(" ")
            old_mode, new_mode, status = fields[0][1:], fields[1], fields[4]
            if status.startswith("M") and old_mode != new_mode and {old_mode, new_mode} == {self.MODE_EXEC, self.MODE_NOEXEC}:
                flips.append((path, old_mode, new_mode))
        return flips

    def build_tree_with_modes(self, sha: str, flagged: list[tuple[str, str, str]], index_path: str) -> str:
        if not flagged:
            return self.output(["rev-parse", f"{sha}^{{tree}}"]).strip()

        env = os.environ.copy()
        env["GIT_INDEX_FILE"] = index_path

        self.run(["read-tree", f"{sha}^{{tree}}"], env=env)
        for path, correct_mode, _ in flagged:
            flag = "+x" if correct_mode == self.MODE_EXEC else "-x"
            self.run(["update-index", f"--chmod={flag}", "--", path], env=env)
        return self.output(["write-tree"], env=env).strip()

    def recommit_with_tree(self, sha: str, tree: str, parent: str | None) -> str:
        body = self.output(["cat-file", "-p", sha])
        header, _, _ = body.partition("\n\n")
        if any(line.startswith("gpgsig ") for line in header.splitlines()):
            raise CommandError(f"commit {sha} is GPG-signed; rewriting it would drop the signature, aborting")

        an, ae, ad, cn, ce, cd = self.output(
            ["log", "-1", "--date=raw", "--format=%an%x00%ae%x00%ad%x00%cn%x00%ce%x00%cd", sha]
        ).split("\0")
        message = self.output(["log", "-1", "--format=%B", sha]).rstrip("\n") + "\n"

        env = os.environ.copy()
        env.update({
            "GIT_AUTHOR_NAME": an,
            "GIT_AUTHOR_EMAIL": ae,
            "GIT_AUTHOR_DATE": ad,
            "GIT_COMMITTER_NAME": cn,
            "GIT_COMMITTER_EMAIL": ce,
            "GIT_COMMITTER_DATE": cd,
        })

        with tempfile.NamedTemporaryFile(mode="w", prefix="git-revert-mod-msg-", delete=False) as msgfile:
            msgfile.write(message)
            msgfile_path = msgfile.name
        try:
            args = ["commit-tree", tree]
            if parent:
                args += ["-p", parent]
            args += ["-F", msgfile_path]
            return self.output(args, env=env).strip()
        finally:
            os.unlink(msgfile_path)

    def fix_index_mode(self, path: str, correct_mode: str) -> None:
        flag = "+x" if correct_mode == self.MODE_EXEC else "-x"
        self.run(["update-index", f"--chmod={flag}", "--", path])

    def fix_worktree_mode(self, path: str, correct_mode: str, current_mode: str) -> None:
        """
        Restores the working tree file's actual on-disk permission via a mode-only patch applied
        with "git apply", rather than an OS-level chmod call, so the fix goes through the same
        code path git itself uses (consistent whether git is native or Cygwin), and leaves any
        content change to the file untouched.
        """
        patch = f"diff --git a/{path} b/{path}\nold mode {current_mode}\nnew mode {correct_mode}\n"
        self.run(["apply", "-"], input=patch)

    def backup_ref(self, ref: str, sha: str) -> None:
        self.run(["update-ref", ref, sha])

    def reset_hard(self, sha: str) -> None:
        self.run(["reset", "--hard", sha])

    def merged_branches(self, ref: str) -> list[str]:
        output = self.output(["branch", "--format=%(refname:short)", "--merged", ref])
        return [line.strip() for line in output.splitlines() if line.strip()]

    def list_local_branches(self) -> list[str]:
        output = self.output(["for-each-ref", "--format=%(refname:short)", "refs/heads/"])
        return [line.strip() for line in output.splitlines() if line.strip()]

    def merge_base(self, a: str, b: str) -> str | None:
        result = self.run(["merge-base", a, b], check=False)
        return result.stdout.strip() if result.returncode == 0 else None

    def changed_paths(self, base: str, rev: str) -> list[str]:
        output = self.output(["diff", "--name-only", base, rev])
        return [line.strip() for line in output.splitlines() if line.strip()]

    def is_squash_merged(self, branch: str, target: str) -> bool:
        """
        Content-based merge test, for branches squashed into a single commit on their way into
        the target (so they are not an ancestor of it, and "git branch --merged" misses them).

        Finds every path the branch touched since it diverged from the target (base = their
        merge-base), then checks whether the target's current version of exactly those paths is
        byte-identical to the branch tip's version. If so, whatever the branch introduced is
        still present in the target verbatim, however many commits or however it was squashed;
        this deliberately does not try to match the branch to a specific commit in target.

        A branch that made no changes relative to the merge-base (i.e. is itself an ancestor)
        is reported as not squash-merged here since "git branch --merged" already covers that
        case; a branch whose files were touched again independently in the target after the
        merge (so they no longer match byte-for-byte) is also reported as not merged, since it
        is no longer clear that all of the branch's content is still present.
        """
        base = self.merge_base(branch, target)
        if base is None:
            return False
        paths = self.changed_paths(base, branch)
        if not paths:
            return False
        result = self.run(["diff", "--quiet", target, branch, "--"] + paths, check=False)
        return result.returncode == 0

    def delete_branch(self, name: str) -> None:
        # "-D" rather than "-d": we already verified the branch is merged (via --merged against
        # the requested target), so we don't need git's own re-check here -- which is just as
        # well, since "-d" additionally insists the branch be merged into its configured
        # @{upstream} (e.g. refs/remotes/origin/<branch>), and refuses otherwise even when it is
        # merged into HEAD/the target, which is overly strict for what this command is doing.
        self.run(["branch", "-D", name])


class GitRevertModCommand(MainSubCommand):
    """
    By default, fixes unintended executable-bit flips (100644 <-> 100755) in local uncommitted
    changes (staged and/or unstaged), leaving any real content changes to those files untouched.

    With --since <ref>, instead walks the commits in the range (since^..HEAD], i.e. "since" itself
    is included, and for every commit that flipped a tracked file's executable bit, rewrites that
    commit so the file keeps its parent's mode while keeping any real content change from that
    commit. Commits after the first rewritten one necessarily get a new sha (their parent changed)
    even if they carry no mode flip themselves.
    """

    since: str = None
    dry_run: bool = False

    def __init__(self, parent):
        super().__init__(parent)
        self.main = parent
        self.git = Git()

    def setup(self, args) -> int | None:
        parser = argparse.ArgumentParser(prog=args[0], description="Revert unintended file mode (executable bit) changes")
        parser.add_argument("--since", help="work on commits instead of uncommitted changes: the commit to start from, inclusive (e.g. HEAD, HEAD^1, or a commit hash)")
        parser.add_argument("--dry-run", action="store_true", help="only report the mode flips found, do not fix anything")

        parser.parse_args(args[1:], namespace=self)

        return None

    def execute(self) -> int:
        try:
            if self.since is not None:
                return self.execute_commits()
            else:
                return self.execute_worktree()
        except CommandError as e:
            print(f"error: {e}", file=sys.stderr)
            return 1

    def execute_worktree(self) -> int:
        # Two independent comparisons against the same ground truth (HEAD), fixed independently,
        # so it does not matter whether a file's mode drifted in the index, the working tree
        # file, or both.
        staged = self.git.find_mode_flips(["--cached"])
        worktree = self.git.find_mode_flips(["HEAD"])

        if not staged and not worktree:
            print("No unintended file mode changes found; nothing to do.")
            return 0

        staged_paths = {path for path, _, _ in staged}
        worktree_paths = {path for path, _, _ in worktree}

        print("File mode changes found:")
        for path in sorted(staged_paths | worktree_paths):
            where = ", ".join(w for w, in_set in (("index", path in staged_paths), ("worktree", path in worktree_paths)) if in_set)
            print(f"  {path} ({where})")

        if self.dry_run:
            return 0

        for path, correct_mode, _ in staged:
            self.git.fix_index_mode(path, correct_mode)

        for path, correct_mode, current_mode in worktree:
            self.git.fix_worktree_mode(path, correct_mode, current_mode)

        return 0

    def execute_commits(self) -> int:
        if not self.git.is_worktree_clean():
            raise CommandError("working tree is not clean; commit or stash changes first")

        head = self.git.rev_parse("HEAD")
        since_sha = self.git.rev_parse(self.since)

        base = self.git.rev_parse_parent(since_sha)
        if base is not None:
            commits = self.git.commits_between(base, head)
        else:
            commits = self.git.commits_between(since_sha, head)
            commits.insert(0, since_sha)

        if not commits:
            print("No commits in range; nothing to do.")
            return 0

        branch = self.git.current_branch()

        new_parent = base
        rewritten = False
        report: list[tuple[str, str, list[str]]] = []

        with tempfile.TemporaryDirectory(prefix="git-revert-mod-") as tmpdir:
            index_path = os.path.join(tmpdir, "index")
            for sha in commits:
                orig_parent = self.git.parent_of(sha)

                flagged = self.git.find_mode_flips([orig_parent, sha]) if orig_parent else []

                if not rewritten and not flagged:
                    new_commit = sha
                else:
                    tree = self.git.build_tree_with_modes(sha, flagged, index_path)
                    new_commit = self.git.recommit_with_tree(sha, tree, new_parent)
                    rewritten = True

                if flagged:
                    report.append((sha, new_commit, [path for path, _, _ in flagged]))

                new_parent = new_commit

        final_head = new_parent

        if final_head == head:
            print("No unintended file mode changes found; nothing to do.")
            return 0

        print("Reverted file mode changes:")
        for old_sha, new_sha, files in report:
            print(f"  {old_sha[:10]} -> {new_sha[:10]}: {', '.join(files)}")

        target = f"branch {branch}" if branch else "HEAD"

        if self.dry_run:
            print(f"\ndry run: would move {target} from {head[:10]} to {final_head[:10]}")
            return 0

        backup_ref = f"refs/original/git-revert-mod/{branch or 'HEAD'}"
        self.git.backup_ref(backup_ref, head)
        print(f"original {target} backed up as {backup_ref}")

        self.git.reset_hard(final_head)
        print(f"{target} now at {final_head[:10]}")

        return 0


class GitPruneMergedCommand(MainSubCommand):
    """
    Deletes local branches that have already been merged into any of the given target branches.

    For each target branch, runs "git branch --merged <branch>" to find the branches fully
    merged into it, takes the union across all targets, and deletes the result via
    "git branch -D". A plain "-d" is not used because it additionally requires the branch to be
    merged into its configured @{upstream}, which can reject a branch we already confirmed is
    merged into the target (e.g. a stale or squash-merged remote-tracking ref); the "--merged"
    check above is this command's own safety check instead. The target branches themselves and
    the current branch are always excluded from deletion, even if they would otherwise show up
    as merged (e.g. a target merged into another target).

    With --squash-merged, also considers every other local branch: a branch is often rebuilt
    from many small commits while it lands in the target as one squashed commit, so it is never
    an ancestor of the target and "git branch --merged" alone will not see it. Those branches
    are instead tested by content, via Git.is_squash_merged() -- see there for exactly what
    counts as a match. This is a heuristic, not a guarantee from git itself, so matches found
    this way are reported separately from the plain ancestor matches.
    """

    branches: list[str] = []
    dry_run: bool = False
    ignore_errors: bool = False
    squash_merged: bool = False

    def __init__(self, parent):
        super().__init__(parent)
        self.main = parent
        self.git = Git()

    def setup(self, args) -> int | None:
        parser = argparse.ArgumentParser(prog=args[0], description="Delete local branches already merged into the given branches")
        parser.add_argument("branches", nargs="+", help="branches to check merged status against (e.g. main develop)")
        parser.add_argument("--dry-run", action="store_true", help="only report the branches that would be deleted, do not delete anything")
        parser.add_argument("-i", "--ignore-errors", action="store_true", help="if deleting a branch fails, continue with the remaining branches instead of stopping, then report all the failures at the end")
        parser.add_argument("-s", "--squash-merged", action="store_true", help="also test every other local branch by content, to catch branches that were squashed into a single commit in the target rather than merged as-is")

        parser.parse_args(args[1:], namespace=self)

        return None

    def execute(self) -> int:
        try:
            return self.execute_prune()
        except CommandError as e:
            print(f"error: {e}", file=sys.stderr)
            return 1

    def execute_prune(self) -> int:
        current = self.git.current_branch()
        excluded = set(self.branches) | ({current} if current else set())

        ancestor_merged: set[str] = set()
        for branch in self.branches:
            ancestor_merged |= set(self.git.merged_branches(branch))
        ancestor_merged -= excluded

        squash_merged: set[str] = set()
        if self.squash_merged:
            remaining = sorted(set(self.git.list_local_branches()) - excluded - ancestor_merged)
            for name in remaining:
                if any(self.git.is_squash_merged(name, target) for target in self.branches):
                    squash_merged.add(name)

        candidates = sorted(ancestor_merged | squash_merged)

        if not candidates:
            print("No merged branches found; nothing to do.")
            return 0

        print("Merged branches found:")
        for name in candidates:
            note = " (squash-merged, content match only)" if name in squash_merged else ""
            print(f"  {name}{note}")

        if self.dry_run:
            return 0

        failures: list[tuple[str, str]] = []
        for name in candidates:
            if self.ignore_errors:
                try:
                    self.git.delete_branch(name)
                except CommandError as e:
                    failures.append((name, str(e)))
                    continue
            else:
                self.git.delete_branch(name)
            print(f"deleted {name}")

        if failures:
            print("\nFailed to delete the following branches:", file=sys.stderr)
            for name, error in failures:
                print(f"  {name}: {error}", file=sys.stderr)
            return 1

        return 0


class _PrefixLogger(logging.LoggerAdapter):
    """
    Prefixes every message with given text (e.g. destination directory), so messages from
    several concurrently running instances can be told apart.
    """

    def __init__(self, logger: logging.Logger, prefix: str):
        super().__init__(logger, {})
        # the prefix becomes part of format string, so escape any % in it
        self.prefix = prefix.replace("%", "%%")

    def process(self, msg, kwargs):
        return f"{self.prefix}: {msg}", kwargs


class _PollWatcher:
    """
    Fallback change "notification": simply requests full rescan every interval.
    """

    name = "poll"

    def __init__(self, interval: float):
        self.interval = max(0.1, interval)
        self.next = time.monotonic() + self.interval

    def wait(self, timeout: float | None) -> list[tuple[str | None, bool]]:
        remaining = self.next - time.monotonic()
        if timeout is not None and timeout < remaining:
            time.sleep(max(0.0, timeout))
            return []
        time.sleep(max(0.0, remaining))
        self.next = time.monotonic() + self.interval
        return [(None, True)]

    def close(self) -> None:
        pass


class _WatchdogWatcher:
    """
    Change notification through Python watchdog package, which supports inotify (Linux),
    FSEvents (MacOS), kqueue (BSD) and ReadDirectoryChangesW (Windows).
    """

    name = "watchdog"

    def __init__(self, root: str):
        from watchdog.observers import Observer
        from watchdog.events import FileSystemEventHandler

        self.queue: queue.Queue = queue.Queue()
        events = self.queue

        class Handler(FileSystemEventHandler):
            def on_any_event(self, event):
                if event.event_type in ("opened", "closed_no_write"):
                    return
                recursive = event.is_directory and event.event_type in ("created", "moved")
                events.put((os.fsdecode(event.src_path), recursive and event.event_type == "created"))
                dest_path = getattr(event, "dest_path", None)
                if dest_path:
                    events.put((os.fsdecode(dest_path), recursive))

        self.observer = Observer()
        self.observer.schedule(Handler(), root, recursive=True)
        self.observer.start()

    def wait(self, timeout: float | None) -> list[tuple[str | None, bool]]:
        # limit the blocking time, so KeyboardInterrupt is delivered also on Windows
        timeout = 1.0 if timeout is None else min(timeout, 1.0)
        try:
            result = [self.queue.get(timeout=timeout)]
        except queue.Empty:
            return []
        while True:
            try:
                result.append(self.queue.get_nowait())
            except queue.Empty:
                return result

    def close(self) -> None:
        self.observer.stop()
        self.observer.join()


class _InotifyWatcher:
    """
    Change notification through Linux inotify, accessed directly through ctypes, so it does not
    need any extra package. Watches are added recursively for every directory, including the
    directories created or moved in later.
    """

    name = "inotify"

    IN_MODIFY = 0x00000002
    IN_ATTRIB = 0x00000004
    IN_CLOSE_WRITE = 0x00000008
    IN_MOVED_FROM = 0x00000040
    IN_MOVED_TO = 0x00000080
    IN_CREATE = 0x00000100
    IN_DELETE = 0x00000200
    IN_DELETE_SELF = 0x00000400
    IN_MOVE_SELF = 0x00000800
    IN_Q_OVERFLOW = 0x00004000
    IN_IGNORED = 0x00008000
    IN_ONLYDIR = 0x01000000
    IN_DONT_FOLLOW = 0x02000000
    IN_ISDIR = 0x40000000
    IN_CLOEXEC = 0o2000000

    WATCH_MASK = IN_MODIFY | IN_ATTRIB | IN_CLOSE_WRITE | IN_MOVED_FROM | IN_MOVED_TO | IN_CREATE | IN_DELETE \
        | IN_DELETE_SELF | IN_MOVE_SELF | IN_ONLYDIR | IN_DONT_FOLLOW

    def __init__(self, root: str, is_excluded, log: logging.LoggerAdapter):
        import ctypes
        import ctypes.util

        self.ctypes = ctypes
        self.libc = ctypes.CDLL(ctypes.util.find_library("c") or "libc.so.6", use_errno=True)
        self.libc.inotify_init1.argtypes = [ctypes.c_int]
        self.libc.inotify_add_watch.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_uint32]
        self.is_excluded = is_excluded
        self.log = log
        self.fd = self.libc.inotify_init1(self.IN_CLOEXEC)
        if self.fd < 0:
            err = ctypes.get_errno()
            raise OSError(err, f"inotify_init1 failed: {os.strerror(err)}")
        self.wds: dict[int, str] = {}
        self.add_tree(root)

    def add_watch(self, path: str) -> None:
        wd = self.libc.inotify_add_watch(self.fd, os.fsencode(path), self.WATCH_MASK)
        if wd < 0:
            err = self.ctypes.get_errno()
            if err == errno.ENOSPC:
                self.log.warning("inotify watch limit reached, increase sysctl fs.inotify.max_user_watches, not watching: %s", path)
            elif err not in (errno.ENOENT, errno.ENOTDIR):
                self.log.warning("failed to watch %s: %s", path, os.strerror(err))
            return
        self.wds[wd] = path

    def add_tree(self, path: str) -> None:
        if self.is_excluded(path):
            return
        for dirpath, dirnames, _ in os.walk(path):
            dirnames[:] = [d for d in dirnames if not self.is_excluded(os.path.join(dirpath, d))]
            self.add_watch(dirpath)

    def wait(self, timeout: float | None) -> list[tuple[str | None, bool]]:
        ready, _, _ = select.select([self.fd], [], [], timeout)
        if not ready:
            return []
        data = os.read(self.fd, 256 * 1024)
        events: list[tuple[str | None, bool]] = []
        offset = 0
        while offset + 16 <= len(data):
            wd, mask, _cookie, length = struct.unpack_from("iIII", data, offset)
            name = data[offset + 16:offset + 16 + length].rstrip(b"\0")
            offset += 16 + length
            if mask & self.IN_Q_OVERFLOW:
                self.log.warning("inotify queue overflow, doing full rescan")
                events.append((None, True))
                continue
            if mask & self.IN_IGNORED:
                self.wds.pop(wd, None)
                continue
            base = self.wds.get(wd)
            if base is None:
                continue
            path = os.path.join(base, os.fsdecode(name)) if name else base
            if (mask & self.IN_ISDIR) and (mask & (self.IN_CREATE | self.IN_MOVED_TO)):
                # new directory: watch it and sync its whole content, as files might have been
                # created inside before the watch was added
                self.add_tree(path)
                events.append((path, True))
            else:
                events.append((path, False))
        return events

    def close(self) -> None:
        os.close(self.fd)


class KeepSyncCommand(MainSubCommand):
    """
    Keeps destination directory in sync with source directory: starts watching the source for
    changes, does an initial full sync and then propagates the changes as they happen.

    The sync is one-directional (source -> destination). Files are considered equal when their
    size and modification time match (copies preserve the modification time). Files are written
    to a temporary file next to the target first and then atomically renamed into place.
    Deletions are propagated too, unless --no-delete is given. Excluded paths are neither copied
    nor deleted in destination.

    Change notification backends, tried in this order by --watcher auto:
      watchdog: Python watchdog package, if installed (inotify, FSEvents, kqueue,
                ReadDirectoryChangesW, i.e. Linux, MacOS, BSD and Windows)
      inotify:  Linux inotify used directly via ctypes, no extra dependency
      poll:     periodic full rescan, works everywhere
    """

    TMP_SUFFIX = ".keep-sync-tmp"

    source: str
    destination: str
    delete: bool = True
    excludes: list[str] = []
    watcher: str = "auto"
    delay: float = 0.5
    poll_interval: float = 2.0
    rescan_interval: float = 0.0
    mtime_window: float = 0.01
    once: bool = False
    dry_run: bool = False

    def __init__(self, parent):
        super().__init__(parent)
        self.main = parent
        self.dest_rel: str | None = None

    def setup(self, args) -> int | None:
        parser = argparse.ArgumentParser(prog=args[0], description="Keep destination directory in sync with source directory, watching the source for changes")
        parser.add_argument("source", help="source directory")
        parser.add_argument("destination", help="destination directory, created if it does not exist")
        parser.add_argument("--no-delete", dest="delete", action="store_false", help="do not delete files in destination which do not exist in source")
        parser.add_argument("-x", "--exclude", dest="excludes", action="append", default=[], help="glob pattern to exclude, matched against relative path (with /) and file name of each path component, can be repeated")
        parser.add_argument("-w", "--watcher", choices=["auto", "watchdog", "inotify", "poll"], default="auto", help="change notification backend, auto uses watchdog if installed, inotify on Linux, poll otherwise (default auto)")
        parser.add_argument("--delay", type=float, default=0.5, help="seconds to wait for changes to settle before syncing (default 0.5)")
        parser.add_argument("--poll-interval", type=float, default=2.0, help="seconds between rescans for poll watcher (default 2)")
        parser.add_argument("--rescan-interval", type=float, default=0.0, help="additionally do full rescan every this many seconds, 0 disables (default 0)")
        parser.add_argument("--mtime-window", type=float, default=0.01, help="modification time difference in seconds still considered equal, use 2 for FAT (default 0.01)")
        parser.add_argument("--once", action="store_true", help="only do the initial sync and exit")
        parser.add_argument("-n", "--dry-run", action="store_true", help="only report what initial sync would do, implies --once")

        parser.parse_args(args[1:], namespace=self)

        self.source = os.path.abspath(self.source)
        self.destination = os.path.abspath(self.destination)
        self.log = _PrefixLogger(logging.getLogger(), self.destination)
        if not os.path.isdir(self.source):
            print(f"error: source is not a directory: {self.source}", file=sys.stderr)
            return 1
        if self._is_within(self.source, self.destination):
            print(f"error: source must not be the destination or be inside it: {self.source}", file=sys.stderr)
            return 1
        if self._is_within(self.destination, self.source):
            self.dest_rel = os.path.relpath(self.destination, self.source).replace(os.sep, "/")

        return None

    def execute(self) -> int:
        try:
            return self.execute_sync()
        except CommandError as e:
            print(f"error: {e}", file=sys.stderr)
            return 1

    def execute_sync(self) -> int:
        watcher = None
        if not self.once and not self.dry_run:
            # start watching before the initial sync, so changes done during it are not lost
            watcher = self.create_watcher()
        try:
            self.log.info("initial sync from %s", self.source)
            if not self.dry_run:
                os.makedirs(self.destination, exist_ok=True)
            self.sync_tree("")
            if watcher is None:
                return 0
            self.log.info("watching %s using %s", self.source, watcher.name)
            self.watch_loop(watcher)
        except KeyboardInterrupt:
            pass
        finally:
            if watcher is not None:
                watcher.close()
        return 0

    def create_watcher(self):
        kind = self.watcher
        if kind in ("auto", "watchdog"):
            try:
                return _WatchdogWatcher(self.source)
            except ImportError:
                if kind == "watchdog":
                    raise CommandError("watchdog package is not installed, install it with: pip install watchdog")
        if kind in ("auto", "inotify"):
            if sys.platform.startswith("linux"):
                try:
                    return _InotifyWatcher(self.source, self.is_excluded_abs, self.log)
                except OSError as e:
                    if kind == "inotify":
                        raise CommandError(f"cannot use inotify: {e}")
                    self.log.warning("cannot use inotify, falling back to polling: %s", e)
            elif kind == "inotify":
                raise CommandError("inotify is available only on Linux")
        return _PollWatcher(self.poll_interval)

    def watch_loop(self, watcher) -> None:
        dirty: dict[str, bool] = {}
        first = last = 0.0
        max_delay = max(self.delay * 10, 5.0)
        next_rescan = time.monotonic() + self.rescan_interval if self.rescan_interval > 0 else None
        while True:
            now = time.monotonic()
            timeout = None
            if dirty:
                timeout = max(0.0, min(last + self.delay, first + max_delay) - now)
            if next_rescan is not None:
                rescan_timeout = max(0.0, next_rescan - now)
                timeout = rescan_timeout if timeout is None else min(timeout, rescan_timeout)

            events = watcher.wait(timeout)

            now = time.monotonic()
            for path, recursive in events:
                rel = "" if path is None else self.to_rel(path)
                if rel is None:
                    continue
                if not dirty:
                    first = now
                last = now
                dirty[rel] = dirty.get(rel, False) or recursive or path is None
                if path is None:
                    # full rescan request (poll or overflow), no point waiting for more changes
                    first = now - max_delay
            if next_rescan is not None and now >= next_rescan:
                dirty[""] = True
                first = last = now - max_delay
                next_rescan = now + self.rescan_interval
            if dirty and (now >= last + self.delay or now >= first + max_delay):
                self.process_dirty(dirty)
                dirty = {}

    def process_dirty(self, dirty: dict[str, bool]) -> None:
        if dirty.get(""):
            self.sync_tree("")
            return
        for rel in sorted(dirty):
            if rel:
                self.sync_changed(rel, dirty[rel])

    @staticmethod
    def _is_within(path: str, parent: str) -> bool:
        path, parent = os.path.normcase(path), os.path.normcase(parent)
        try:
            return os.path.commonpath([path, parent]) == parent
        except ValueError:
            return False

    @staticmethod
    def _lstat(path: str) -> os.stat_result | None:
        try:
            return os.lstat(path)
        except (FileNotFoundError, NotADirectoryError):
            return None

    @staticmethod
    def _join(rel: str, name: str) -> str:
        return os.path.join(rel, name) if rel else name

    def src_path(self, rel: str) -> str:
        return os.path.join(self.source, rel) if rel else self.source

    def dst_path(self, rel: str) -> str:
        return os.path.join(self.destination, rel) if rel else self.destination

    def to_rel(self, path: str) -> str | None:
        path = os.path.abspath(path)
        if not self._is_within(path, self.source):
            return None
        rel = os.path.relpath(path, self.source)
        return "" if rel == "." else rel

    def is_excluded(self, rel: str) -> bool:
        parts = rel.replace(os.sep, "/").split("/")
        if parts[-1].endswith(self.TMP_SUFFIX):
            return True
        for i in range(1, len(parts) + 1):
            prefix = "/".join(parts[:i])
            if prefix == self.dest_rel:
                return True
            for pattern in self.excludes:
                if fnmatch.fnmatch(prefix, pattern) or fnmatch.fnmatch(parts[i - 1], pattern):
                    return True
        return False

    def is_excluded_abs(self, path: str) -> bool:
        rel = self.to_rel(path)
        return rel is None or (rel != "" and self.is_excluded(rel))

    def sync_changed(self, rel: str, recursive: bool) -> None:
        # make sure the parent exists in destination, otherwise sync from the top-most missing one
        parts = rel.split(os.sep)
        for i in range(1, len(parts)):
            ancestor = os.sep.join(parts[:i])
            if not os.path.isdir(self.dst_path(ancestor)):
                self.sync_entry(ancestor, True)
                return
        self.sync_entry(rel, recursive)

    def sync_tree(self, rel: str) -> None:
        try:
            src_names = set(os.listdir(self.src_path(rel)))
        except (FileNotFoundError, NotADirectoryError):
            return
        try:
            dst_names = set(os.listdir(self.dst_path(rel)))
        except (FileNotFoundError, NotADirectoryError):
            dst_names = set()
        for name in sorted(src_names):
            self.sync_entry(self._join(rel, name), True)
        if self.delete:
            for name in sorted(dst_names - src_names):
                child = self._join(rel, name)
                if self.is_excluded(child):
                    continue
                if (dst_stat := self._lstat(self.dst_path(child))) is not None:
                    self.guarded(child, lambda: self.remove(child, dst_stat))

    def sync_entry(self, rel: str, recursive: bool) -> None:
        if self.is_excluded(rel):
            return
        self.guarded(rel, lambda: self._sync_entry(rel, recursive))

    def guarded(self, rel: str, action) -> None:
        try:
            action()
        except OSError as e:
            self.log.warning("failed to sync %s: %s", rel, e)

    def _sync_entry(self, rel: str, recursive: bool) -> None:
        src = self.src_path(rel)
        dst = self.dst_path(rel)
        src_stat = self._lstat(src)
        dst_stat = self._lstat(dst)
        if src_stat is None:
            if dst_stat is not None and self.delete:
                self.remove(rel, dst_stat)
            return

        if stat.S_ISDIR(src_stat.st_mode):
            if dst_stat is not None and not stat.S_ISDIR(dst_stat.st_mode):
                self.remove(rel, dst_stat)
                dst_stat = None
            if dst_stat is None:
                self.log.info("mkdir %s", rel)
                if not self.dry_run:
                    os.makedirs(dst, exist_ok=True)
                recursive = True
            if recursive:
                self.sync_tree(rel)

        elif stat.S_ISLNK(src_stat.st_mode):
            target = os.readlink(src)
            if dst_stat is not None:
                if stat.S_ISLNK(dst_stat.st_mode) and os.readlink(dst) == target:
                    return
                self.remove(rel, dst_stat)
            self.log.info("symlink %s -> %s", rel, target)
            if not self.dry_run:
                os.symlink(target, dst, target_is_directory=os.path.isdir(src))

        elif stat.S_ISREG(src_stat.st_mode):
            if dst_stat is not None and not stat.S_ISREG(dst_stat.st_mode):
                self.remove(rel, dst_stat)
                dst_stat = None
            if dst_stat is None or src_stat.st_size != dst_stat.st_size \
                    or abs(src_stat.st_mtime - dst_stat.st_mtime) > self.mtime_window:
                self.copy_file(rel)

        else:
            self.log.debug("skipping special file %s", rel)

    def copy_file(self, rel: str) -> None:
        self.log.info("copy %s", rel)
        if self.dry_run:
            return
        dst = self.dst_path(rel)
        tmp = os.path.join(os.path.dirname(dst), "." + os.path.basename(dst) + self.TMP_SUFFIX)
        try:
            shutil.copy2(self.src_path(rel), tmp)
            try:
                os.replace(tmp, dst)
            except PermissionError:
                # read-only target on Windows cannot be replaced
                os.chmod(dst, stat.S_IWRITE | stat.S_IREAD)
                os.replace(tmp, dst)
        except BaseException:
            try:
                os.unlink(tmp)
            except OSError:
                pass
            raise

    def remove(self, rel: str, dst_stat: os.stat_result) -> None:
        self.log.info("delete %s", rel)
        if self.dry_run:
            return
        dst = self.dst_path(rel)
        if stat.S_ISDIR(dst_stat.st_mode):
            shutil.rmtree(dst)
        else:
            os.unlink(dst)


class Main(Command):
    command: Command | None = None
    subcommand: list[str] = []

    def setup(self, args) -> int | None:
        parser = argparse.ArgumentParser(prog=args[0], description="Zbynek Dev Tool")
        parser.add_argument("subcommand", type=str, nargs=argparse.REMAINDER)

        parser.parse_args(args[1:], namespace=self)

        if len(self.subcommand) < 1:
            print(f"usage: {args[0]} subcommand ...", file=sys.stderr)
            return 122

        if self.subcommand[0] == 'spotless-to-diff':
            self.command = SpotlessToDiffCommand(self)
        elif self.subcommand[0] == 'log-to-timestamp':
            self.command = LogToTimestamp(self)
        elif self.subcommand[0] == 'git-revert-mod':
            self.command = GitRevertModCommand(self)
        elif self.subcommand[0] == 'git-prune-merged':
            self.command = GitPruneMergedCommand(self)
        elif self.subcommand[0] == 'keep-sync':
            self.command = KeepSyncCommand(self)
        else:
            print("Supported subcommands: spotless-to-diff, log-to-timestamp, git-revert-mod, git-prune-merged, keep-sync", file=sys.stderr)
            return 122

        self.subcommand[0] = args[0] + " " + self.subcommand[0]
        return self.command.run(self.subcommand)


if __name__ == "__main__":
    logging.basicConfig(
        format='%(asctime)s %(levelname)-8s %(message)s',
        level=logging.INFO,
        datefmt='%Y-%m-%d %H:%M:%S'
    )

    sys.exit(Main().run(sys.argv))
