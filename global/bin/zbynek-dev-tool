from __future__ import annotations

import logging
import os
import re
import subprocess
import sys
import tempfile
import argparse


class Command:
    def run(self, args) -> int:
        exit: int | None = self.setup(args)
        if exit is not None:
            return exit
        return self.execute()

    def setup(self, args) -> int | None:
        return None

    def execute(self) -> int:
        return 0


class MainSubCommand(Command):
    main: Main

    def __init__(self, parent):
        self.main = parent


class SpotlessToDiffCommand(MainSubCommand):
    def __init__(self, parent):
        super().__init__(parent)
        self.main = parent

    def setup(self, args) -> int | None:
        parser = argparse.ArgumentParser(prog=args[0], description="Convert spotless to diff")

        parser.parse_args(args[1:], namespace=self)

        return None

    def execute(self) -> int:
        EMPTY_PATTERN = re.compile(r'^\s*$')
        CHANGE_PATTERN = re.compile(r'^(\s*)(@@ .*)$')
        FILE_PATTERN = re.compile(r'^\s+(.*\S)\s*')
        line = None
        while True:
            if line is None and (line := sys.stdin.readline()) == "":
                break
            empty_lines = False
            if not (fm := FILE_PATTERN.match(line)):
                line = None
                continue
            if (line := sys.stdin.readline()) == "":
                break
            if EMPTY_PATTERN.match(line):
                if (line := sys.stdin.readline()) == "":
                    break
                empty_lines = True
            if not (cm := CHANGE_PATTERN.match(line)):
                break
            indent = cm.group(1)
            file = fm.group(1)
            print(f"diff a/{file} b/{file}")
            print(f"--- a/{file}")
            print(f"+++ a/{file}")
            print(cm.group(2))
            while True:
                line = sys.stdin.readline()
                if empty_lines:
                    if not EMPTY_PATTERN.match(line):
                        raise ValueError("Expected empty line, got: " + line)
                    line = sys.stdin.readline()
                if line == "":
                    break
                if not line.startswith(indent):
                    if not EMPTY_PATTERN.match(line):
                        break
                    else:
                        line = " "
                else:
                    line = line[len(indent):]
                line = re.sub(r'(·+)', lambda m: ' ' * len(m.group(1)), line, flags=0)
                print(line, end = "")

        return 0


class LogToTimestamp(MainSubCommand):
    def __init__(self, parent):
        super().__init__(parent)
        self.main = parent

    def setup(self, args) -> int | None:
        parser = argparse.ArgumentParser(prog=args[0], description="Convert log CSV epoch timestamps to UTC")
        parser.parse_args(args[1:], namespace=self)
        return None

    def execute(self) -> int:
        import csv
        from datetime import datetime, timezone

        reader = csv.reader(sys.stdin)
        for i, row in enumerate(reader):
            if not row:
                continue
            if i == 0 and row[0].strip().lower() == "timestamp":
                continue
            try:
                ts_ms = int(row[0])
                row[0] = (
                        datetime.fromtimestamp(ts_ms / 1000, tz=timezone.utc)
                        .strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"
                )
            except ValueError:
                pass
            message = row[1] if len(row) > 1 else ""
            lines = message.splitlines()
            first = lines[0] if lines else ""
            rest = lines[1:]
            sys.stdout.write(f"{row[0]} {first}\n")
            for line in rest:
                sys.stdout.write(f"\t{line}\n")

        return 0


class CommandError(Exception):
    pass


class Git:
    """
    Thin wrapper around the external "git" binary. All git interaction for the tool goes through
    here (rev-parse, rev-list, diff, read-tree, update-index, write-tree, commit-tree, apply,
    reset) rather than any Python git library, since the Python interpreter may be Windows-native
    while git itself is Cygwin, and the two do not always agree on how paths/indexes/modes behave.
    """

    MODE_EXEC = "100755"
    MODE_NOEXEC = "100644"

    def run(self, args: list[str], env: dict | None = None, input: str | None = None, check: bool = True) -> subprocess.CompletedProcess:
        result = subprocess.run(["git"] + args, capture_output=True, text=True, env=env, input=input)
        if check and result.returncode != 0:
            raise CommandError(f"git {' '.join(args)} failed: {result.stderr.strip()}")
        return result

    def output(self, args: list[str], env: dict | None = None) -> str:
        return self.run(args, env=env).stdout

    def rev_parse(self, rev: str) -> str:
        return self.output(["rev-parse", rev]).strip()

    def rev_parse_parent(self, sha: str) -> str | None:
        result = self.run(["rev-parse", f"{sha}^"], check=False)
        return result.stdout.strip() if result.returncode == 0 else None

    def current_branch(self) -> str | None:
        result = self.run(["symbolic-ref", "--short", "-q", "HEAD"], check=False)
        return result.stdout.strip() if result.returncode == 0 else None

    def is_worktree_clean(self) -> bool:
        return not self.output(["status", "--porcelain"]).strip()

    def commits_between(self, base: str, head: str) -> list[str]:
        return self.output(["rev-list", "--reverse", f"{base}..{head}"]).split()

    def parent_of(self, sha: str) -> str | None:
        parents = self.output(["rev-list", "--parents", "-n1", sha]).split()[1:]
        if len(parents) > 1:
            raise CommandError(f"merge commit {sha} is not supported")
        return parents[0] if parents else None

    def find_mode_flips(self, diff_args: list[str]) -> list[tuple[str, str, str]]:
        """
        Runs "git diff --raw" with the given extra arguments (e.g. two commits, or ["--cached"],
        or no argument at all for worktree-vs-index) and returns the pure executable-bit flips
        found, as (path, correct_mode, current_mode) tuples.
        """
        output = self.output(["diff", "--raw", "--no-renames", "-z"] + diff_args)
        tokens = output.split("\0")
        flips = []
        i = 0
        while i < len(tokens) - 1:
            meta = tokens[i]
            path = tokens[i + 1]
            i += 2
            if not meta:
                continue
            fields = meta.split(" ")
            old_mode, new_mode, status = fields[0][1:], fields[1], fields[4]
            if status.startswith("M") and old_mode != new_mode and {old_mode, new_mode} == {self.MODE_EXEC, self.MODE_NOEXEC}:
                flips.append((path, old_mode, new_mode))
        return flips

    def build_tree_with_modes(self, sha: str, flagged: list[tuple[str, str, str]], index_path: str) -> str:
        if not flagged:
            return self.output(["rev-parse", f"{sha}^{{tree}}"]).strip()

        env = os.environ.copy()
        env["GIT_INDEX_FILE"] = index_path

        self.run(["read-tree", f"{sha}^{{tree}}"], env=env)
        for path, correct_mode, _ in flagged:
            flag = "+x" if correct_mode == self.MODE_EXEC else "-x"
            self.run(["update-index", f"--chmod={flag}", "--", path], env=env)
        return self.output(["write-tree"], env=env).strip()

    def recommit_with_tree(self, sha: str, tree: str, parent: str | None) -> str:
        body = self.output(["cat-file", "-p", sha])
        header, _, _ = body.partition("\n\n")
        if any(line.startswith("gpgsig ") for line in header.splitlines()):
            raise CommandError(f"commit {sha} is GPG-signed; rewriting it would drop the signature, aborting")

        an, ae, ad, cn, ce, cd = self.output(
            ["log", "-1", "--date=raw", "--format=%an%x00%ae%x00%ad%x00%cn%x00%ce%x00%cd", sha]
        ).split("\0")
        message = self.output(["log", "-1", "--format=%B", sha]).rstrip("\n") + "\n"

        env = os.environ.copy()
        env.update({
            "GIT_AUTHOR_NAME": an,
            "GIT_AUTHOR_EMAIL": ae,
            "GIT_AUTHOR_DATE": ad,
            "GIT_COMMITTER_NAME": cn,
            "GIT_COMMITTER_EMAIL": ce,
            "GIT_COMMITTER_DATE": cd,
        })

        with tempfile.NamedTemporaryFile(mode="w", prefix="git-revert-mod-msg-", delete=False) as msgfile:
            msgfile.write(message)
            msgfile_path = msgfile.name
        try:
            args = ["commit-tree", tree]
            if parent:
                args += ["-p", parent]
            args += ["-F", msgfile_path]
            return self.output(args, env=env).strip()
        finally:
            os.unlink(msgfile_path)

    def fix_index_mode(self, path: str, correct_mode: str) -> None:
        flag = "+x" if correct_mode == self.MODE_EXEC else "-x"
        self.run(["update-index", f"--chmod={flag}", "--", path])

    def fix_worktree_mode(self, path: str, correct_mode: str, current_mode: str) -> None:
        """
        Restores the working tree file's actual on-disk permission via a mode-only patch applied
        with "git apply", rather than an OS-level chmod call, so the fix goes through the same
        code path git itself uses (consistent whether git is native or Cygwin), and leaves any
        content change to the file untouched.
        """
        patch = f"diff --git a/{path} b/{path}\nold mode {current_mode}\nnew mode {correct_mode}\n"
        self.run(["apply", "-"], input=patch)

    def backup_ref(self, ref: str, sha: str) -> None:
        self.run(["update-ref", ref, sha])

    def reset_hard(self, sha: str) -> None:
        self.run(["reset", "--hard", sha])


class GitRevertModCommand(MainSubCommand):
    """
    By default, fixes unintended executable-bit flips (100644 <-> 100755) in local uncommitted
    changes (staged and/or unstaged), leaving any real content changes to those files untouched.

    With --since <ref>, instead walks the commits in the range (since^..HEAD], i.e. "since" itself
    is included, and for every commit that flipped a tracked file's executable bit, rewrites that
    commit so the file keeps its parent's mode while keeping any real content change from that
    commit. Commits after the first rewritten one necessarily get a new sha (their parent changed)
    even if they carry no mode flip themselves.
    """

    since: str = None
    dry_run: bool = False

    def __init__(self, parent):
        super().__init__(parent)
        self.main = parent
        self.git = Git()

    def setup(self, args) -> int | None:
        parser = argparse.ArgumentParser(prog=args[0], description="Revert unintended file mode (executable bit) changes")
        parser.add_argument("--since", help="work on commits instead of uncommitted changes: the commit to start from, inclusive (e.g. HEAD, HEAD^1, or a commit hash)")
        parser.add_argument("--dry-run", action="store_true", help="only report the mode flips found, do not fix anything")

        parser.parse_args(args[1:], namespace=self)

        return None

    def execute(self) -> int:
        try:
            if self.since is not None:
                return self.execute_commits()
            else:
                return self.execute_worktree()
        except CommandError as e:
            print(f"error: {e}", file=sys.stderr)
            return 1

    def execute_worktree(self) -> int:
        # Two independent comparisons against the same ground truth (HEAD), fixed independently,
        # so it does not matter whether a file's mode drifted in the index, the working tree
        # file, or both.
        staged = self.git.find_mode_flips(["--cached"])
        worktree = self.git.find_mode_flips(["HEAD"])

        if not staged and not worktree:
            print("No unintended file mode changes found; nothing to do.")
            return 0

        staged_paths = {path for path, _, _ in staged}
        worktree_paths = {path for path, _, _ in worktree}

        print("File mode changes found:")
        for path in sorted(staged_paths | worktree_paths):
            where = ", ".join(w for w, in_set in (("index", path in staged_paths), ("worktree", path in worktree_paths)) if in_set)
            print(f"  {path} ({where})")

        if self.dry_run:
            return 0

        for path, correct_mode, _ in staged:
            self.git.fix_index_mode(path, correct_mode)

        for path, correct_mode, current_mode in worktree:
            self.git.fix_worktree_mode(path, correct_mode, current_mode)

        return 0

    def execute_commits(self) -> int:
        if not self.git.is_worktree_clean():
            raise CommandError("working tree is not clean; commit or stash changes first")

        head = self.git.rev_parse("HEAD")
        since_sha = self.git.rev_parse(self.since)

        base = self.git.rev_parse_parent(since_sha)
        if base is not None:
            commits = self.git.commits_between(base, head)
        else:
            commits = self.git.commits_between(since_sha, head)
            commits.insert(0, since_sha)

        if not commits:
            print("No commits in range; nothing to do.")
            return 0

        branch = self.git.current_branch()

        new_parent = base
        rewritten = False
        report: list[tuple[str, str, list[str]]] = []

        with tempfile.TemporaryDirectory(prefix="git-revert-mod-") as tmpdir:
            index_path = os.path.join(tmpdir, "index")
            for sha in commits:
                orig_parent = self.git.parent_of(sha)

                flagged = self.git.find_mode_flips([orig_parent, sha]) if orig_parent else []

                if not rewritten and not flagged:
                    new_commit = sha
                else:
                    tree = self.git.build_tree_with_modes(sha, flagged, index_path)
                    new_commit = self.git.recommit_with_tree(sha, tree, new_parent)
                    rewritten = True

                if flagged:
                    report.append((sha, new_commit, [path for path, _, _ in flagged]))

                new_parent = new_commit

        final_head = new_parent

        if final_head == head:
            print("No unintended file mode changes found; nothing to do.")
            return 0

        print("Reverted file mode changes:")
        for old_sha, new_sha, files in report:
            print(f"  {old_sha[:10]} -> {new_sha[:10]}: {', '.join(files)}")

        target = f"branch {branch}" if branch else "HEAD"

        if self.dry_run:
            print(f"\ndry run: would move {target} from {head[:10]} to {final_head[:10]}")
            return 0

        backup_ref = f"refs/original/git-revert-mod/{branch or 'HEAD'}"
        self.git.backup_ref(backup_ref, head)
        print(f"original {target} backed up as {backup_ref}")

        self.git.reset_hard(final_head)
        print(f"{target} now at {final_head[:10]}")

        return 0


class Main(Command):
    command: Command | None = None
    subcommand: list[str] = []

    def setup(self, args) -> int | None:
        parser = argparse.ArgumentParser(prog=args[0], description="Zbynek Dev Tool")
        parser.add_argument("subcommand", type=str, nargs=argparse.REMAINDER)

        parser.parse_args(args[1:], namespace=self)

        if len(self.subcommand) < 1:
            print(f"usage: {args[0]} subcommand ...", file=sys.stderr)
            return 122

        if self.subcommand[0] == 'spotless-to-diff':
            self.command = SpotlessToDiffCommand(self)
        elif self.subcommand[0] == 'log-to-timestamp':
            self.command = LogToTimestamp(self)
        elif self.subcommand[0] == 'git-revert-mod':
            self.command = GitRevertModCommand(self)
        else:
            print("Supported subcommands: spotless-to-diff, log-to-timestamp, git-revert-mod", file=sys.stderr)
            return 122

        self.subcommand[0] = args[0] + " " + self.subcommand[0]
        return self.command.run(self.subcommand)


if __name__ == "__main__":
    logging.basicConfig(
        format='%(asctime)s %(levelname)-8s %(message)s',
        level=logging.INFO,
        datefmt='%Y-%m-%d %H:%M:%S'
    )

    sys.exit(Main().run(sys.argv))
